# ==============================================================================
# NovaEnterprise Runtime Environment Configuration (.env.example)
# ==============================================================================
# Single source of truth for all runtime environment settings.
# Guaranteed 100% offline-compatible by default (N1: no external services or API keys required).
# ==============================================================================

# Application & Server Metadata
APP_NAME=NovaEnterprise
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8001

# Structured Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Core AI / Model Settings (N1: fake provider, N2: provider-agnostic)
# Supported LLM providers: fake, openai, anthropic, gemini, groq, cohere, mistral, ollama
LLM_PROVIDER=fake
LLM_MODEL=fake-model
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embeddings

# External LLM Provider API Keys (Leave blank for N1 offline execution)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Storage Backend Protocols (N1: in-memory by default, N3: replaceable)
# Options: memory | qdrant
VECTOR_STORE=memory
# Options: memory | neo4j
GRAPH_STORE=memory

# Research Agent Graph Execution Bounds (Claude.md §7.3, §10.1)
MAX_SUBQUESTIONS=4
MAX_CORRECTIVE_ROUNDS=1

# Security, Ingestion Caps & Rate Limiting (N6, N7)
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=5

# Relational Persistence & Caching
DATABASE_URL=sqlite:///./data/enterprise.db
REDIS_URL=redis://localhost:6379/0
USE_FAKEREDIS=true

# Authentication, Identity & Secrets (Phase 3 / Claude.md §2, §9)
JWT_SECRET_KEY=nova-enterprise-development-jwt-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External Vector Store (Qdrant Cloud / Local Docker)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_chunks

# External Graph Store (Neo4j Aura / Local Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Paths and CORS
SAMPLE_DATA_DIR=sample_data
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
