# ==============================================================================
# NovaEnterprise Multi-Service Docker Compose Environment Variables
# Copy to .env.docker before running `docker compose --env-file .env.docker up`
# ==============================================================================

# Database Credentials & Endpoints
POSTGRES_DB=nova_enterprise
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=nova_password
DATABASE_URL=postgresql://nova_user:nova_password@postgres:5432/nova_enterprise

# Redis Cache & Token-Bucket Rate Limiter
REDIS_URL=redis://redis:6379/0
USE_FAKEREDIS=false

# Vector Store (Qdrant)
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_chunks

# Graph Store (Neo4j)
GRAPH_STORE=neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nova_neo4j_password
NEO4J_AUTH=neo4j/nova_neo4j_password

# Multi-Agent Orchestration & LLM Selection
LLM_PROVIDER=fake
MAX_SUBQUESTIONS=4
MAX_CORRECTIVE_ROUNDS=1

# Enterprise Identity & Security
JWT_SECRET_KEY=nova-enterprise-docker-jwt-secret-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=5

# Container Network URLs
BACKEND_URL=http://backend:8001
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://frontend:3001"]
